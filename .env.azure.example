# Copy to .env.azure on the Azure host (never commit secrets).
# Used by docker-compose.azure.yml for api + agents.

# --- Agents Postgres ---
DATABASE_URL=postgresql://USER:PASSWORD@ezv6psql.postgres.database.azure.com:5432/orchestrator?sslmode=require
CATALOG_DATABASE_URL=postgresql://USER:PASSWORD@ezv6psql.postgres.database.azure.com:5432/ezofis_catalog_new?sslmode=require

# --- Blob OCR ---
AZURE_STORAGE_CONNECTION_STRING=

# --- V6 API (AP metadata → ezfb_*_items, move-next, credits) ---
EZOFIS_API_BASE=https://cloud.ezofis.com/api
EZOFIS_LOGIN_EMAIL=
EZOFIS_LOGIN_PASSWORD=
EZOFIS_ENV=live
