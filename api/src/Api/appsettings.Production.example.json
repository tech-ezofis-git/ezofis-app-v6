{
  "_comment": "Copy relevant keys into appsettings.Production.json on cloud.ezofis.com (or set the same keys as env vars). Do not commit real secrets.",
  "Catalog": {
    "MaxPoolSize": 20
  },
  "TenantDatabase": {
    "MaxPoolSize": 5
  },
  "Hangfire": {
    "RunServerInApi": true,
    "ServerName": "v6-api",
    "MaxPoolSize": 5,
    "ConnectionTimeoutSeconds": 10,
    "CommandTimeoutSeconds": 30
  },
  "WorkflowSla": {
    "Enabled": false,
    "IntervalSeconds": 60,
    "TimerBatchSize": 200,
    "OutboxBatchSize": 30,
    "MaxSendAttempts": 5
  },
  "Sms": {
    "Twilio": {
      "Enabled": false,
      "AccountSid": "",
      "AuthToken": "",
      "FromNumber": "",
      "MessagingServiceSid": "",
      "DefaultCountryCode": "+91"
    }
  },
  "EmailIngest": {
    "HangfireEnabled": true,
    "HangfireCron": "*/5 * * * *",
    "TenantDiscoveryMinutes": 30
  },
  "EzofisAuth": {
    "SigningKey": "REPLACE_ME_set_EzofisAuth__SigningKey_in_Azure",
    "Issuer": "Ezofis",
    "Audience": "Ezofis"
  },
  "FormMasterFileImport": {
    "Enabled": true,
    "UseHangfirePython": true,
    "PythonServiceUrl": "https://cloud.ezofis.com/api/ezDataImport",
    "QueueBlobEnabled": false,
    "QueueBlobPathPrefix": "ezPackages/MasterExcel",
    "TimeoutMinutes": 30,
    "NotificationCategory": "WORKFLOW"
  },
  "Agents": {
    "ChatUrl": "https://cloud.ezofis.com/chat"
  },
  "Branding": {
    "EncryptionKey": "REPLACE_ME_set_Branding__EncryptionKey_in_Azure"
  },
  "RepositoryPythonAssistant": {
    "Enabled": true,
    "SearchIntent": "global_search",
    "ChatbotIntent": "chatbot",
    "TimeoutSeconds": 120
  },
  "Dashboard": {
    "Enabled": true,
    "TimeoutSeconds": 120
  },
  "RepositoryShare": {
    "FrontendBaseUrl": "https://cloud.ezofis.com",
    "SignInPath": "/sign-in"
  },
  "RepositorySignRequest": {
    "FrontendBaseUrl": "https://cloud.ezofis.com",
    "SignRequestPath": "/sign-request"
  }
}
