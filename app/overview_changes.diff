+  const strokeDashoffset = circumference - (percentage / 100) * circumference
+
+  let colorClass = 'stroke-[var(--green-9)]'
+  let bgStrokeClass = 'stroke-[var(--green-3)]'
+  if (percentage < 50) {
+    colorClass = 'stroke-[var(--red-9)]'
+    bgStrokeClass = 'stroke-[var(--red-3)]'
+  } else if (percentage < 90) {
+    colorClass = 'stroke-[var(--orange-9)]'
