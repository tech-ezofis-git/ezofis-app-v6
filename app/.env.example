VITE_BASE_URL="https://cloud.ezofis.com/api"
VITE_GOOGLE_CLIENT_ID=154003149422-r47sovs0tdd345o5d8hj8hceq5og53eg.apps.googleusercontent.com
VITE_MSAL_CLIENT_ID_DEFAULT=315d2d09-9633-419e-8e85-18b747eb5be5
VITE_GEMINI_API_KEY=your-gemini-api-key
VITE_POSTHOG_KEY=your-posthog-project-key
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_V6_BASE_URL="https://cloud.ezofis.com/api"
# Report Agent v2 (AI reports). Defaults to <VITE_V6_BASE_URL>/report-agent-v2, which nginx
# routes to the agents container. Locally, point it at the agents service, e.g.
# VITE_REPORT_AGENT_V2_URL=http://localhost:8010/api/report-agent-v2
# (and set REPORT_AGENT_V2_ENABLED=true, REPORT_AGENT_CORS_ORIGINS=http://localhost:3000 in agents/.env).

# Classic (V5) gateway — optional. On cloud.ezofis.com / localhost it is on by default.
# Set VITE_ENABLE_V5_GATEWAY=false to force current V6-only login.
# VITE_ENABLE_V5_GATEWAY=true
# VITE_V5_API_URL=https://eztapi.ezofis.com/api
# VITE_V5_CLASSIC_PATH=/v5

# GPU box Qwen (Tailscale) — folder AI; set VITE_FOLDER_AI_PROVIDER=gemini to restore Gemini
VITE_FOLDER_AI_PROVIDER=qwen
VITE_QWEN_API_URL=/qwen-proxy/v1
VITE_QWEN_MODEL=qwen3.5-9b
VITE_QWEN_API_KEY=your-qwen-api-key
VITE_COLLABORA_API_URL="https://collabora-2wf8.onrender.com"
VITE_COLLABORA_WOPI_HOST_URL="https://collabora-2wf8.onrender.com"
