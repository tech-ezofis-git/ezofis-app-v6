{
  "$schema_note": "EZOFIS v6 design tokens — machine-readable input for LLM-driven dashboard generation. Source: src/styles/{light,dark,theme}.css, src/pages/settings/helpers/settingsTheme.ts, src/pages/dashboard/**, src/services/ai/dashboardAi.ts.",

  "meta": {
    "product": "EZOFIS v6",
    "ui_library": "Mantine v8 + Tailwind v4",
    "font_stack": {
      "heading": "Poppins, sans-serif",
      "body": "Inter, sans-serif",
      "body_weight_default": 450
    },
    "border_radius_base": "5px",
    "color_mode": "supports light and dark, switched via [data-mantine-color-scheme]"
  },

  "color_scales": {
    "note": "Each scale has 12 steps (gray has 14). Step 9 is the solid/high-saturation step normally used for fills; steps 1-2 are backgrounds; steps 11-12 are text-on-light. Values differ between light and dark mode — both given.",
    "primary": {
      "role": "brand purple — primary actions, focus, active states",
      "light": ["#fdfcff","#fbf7ff","#f3f0ff","#e7d8ff","#dbceff","#cfc4ff","#c3baff","#9c89ff","#7c5cff","#6a4cf0","#5b3ed6","#1f2937"],
