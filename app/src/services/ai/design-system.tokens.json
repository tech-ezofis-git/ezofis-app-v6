  "dashboard_ai_output_schema": {
    "note": "This is the EXACT JSON contract the app's dashboard renderer expects back from a generation model (mirrors src/services/ai/dashboardAi.ts). A model producing a dashboard for this app MUST return an object matching DashboardAiConfig.",
    "type_definitions": {
      "DashboardComponentType": ["header", "kpi_grid", "insights", "pie_chart", "bar_chart", "area_chart", "spend_tiles", "table"],
      "DashboardKpiItem": {
        "id": "string",
        "title": "string",
        "value": "string",
        "subtext": "string",
        "trend": "string (optional, e.g. '+14.2%')",
        "isPositive": "boolean (optional)",
        "enabled": "boolean (optional, default true)"
      },
      "DashboardChartPoint": {
        "name": "string",
        "value": "number",
        "amount": "string (optional, formatted currency label)",
        "profitMargin": "number (optional)",
        "additional_keys": "allowed — chart point is an open record"
      },
      "DashboardInsightItem": {
        "id": "string",
        "text": "string",
        "enabled": "boolean (optional)"
      },
      "DashboardTableRow": {
        "id": "string",
        "title": "string",
        "category": "string",
        "amount": "string",
        "status": ["Approved", "Pending", "Review", "Completed"],
        "date": "string (YYYY-MM-DD)"
      },
      "DashboardSummaryBadge": {
        "label": "string (uppercase short label)",
        "value": "string",
        "color": "string (optional Tailwind class, e.g. 'text-red-9', 'text-green-9', 'text-primary-9')"
      },
      "DashboardWidgetComponent": {
        "id": "string",
        "type": "DashboardComponentType",
        "title": "string (optional)",
        "subtitle": "string (optional)",
        "enabled": "boolean (optional)",
        "summaryBadges": "DashboardSummaryBadge[] (optional)",
        "kpis": "DashboardKpiItem[] (optional, only for type=kpi_grid)",
        "insights": "DashboardInsightItem[] (optional, only for type=insights)",
        "data": "DashboardChartPoint[] | DashboardTableRow[] (optional, for chart/table types)"
      },
      "DashboardSectionGroup": {
        "id": "string",
        "title": "string",
        "subtitle": "string",
        "summaryBadges": "DashboardSummaryBadge[]",
        "enabled": "boolean",
        "isExpanded": "boolean (optional)",
        "components": "DashboardWidgetComponent[]"
      },
      "DashboardAiConfig": {
        "repositoryName": "string",
        "description": "string",
        "sections": "DashboardSectionGroup[]",
        "source": ["gemini", "local"]
      }
    },
    "conventions": {
      "currency_format": "$485.2K style — dollar sign, one decimal, K/M suffix for thousands/millions",
      "trend_format": "signed percentage string, e.g. '+14.2%' or '-10.5%'",
      "date_format": "YYYY-MM-DD",
      "id_pattern": "prefix_xxxxxxxx (8-char random/uuid slice), e.g. 'kpi_a1b2c3d4' — generateUniqueId(prefix) in dashboardAi.ts",
      "sections_per_dashboard": 4,
      "typical_section_pattern": [
        "1. Command Center — kpi_grid (6 KPIs) + insights + pie_chart (risk)",
        "2. Profitability & Cash Position — bar_chart (dual-axis profit vs spend) + area_chart (payment trend) + bar_chart (cash forecast)",
        "3. Supplier Concentration & Risk — pie_chart (top suppliers) + pie_chart (outstanding payables) + spend_tiles (department spend)",
        "4. Aging & Operations Pipeline — bar_chart (approval days) + table (recent records)"
      ]
    },
    "color_assignment_rules": [
      "Use dashboard_categorical_recommended[] in order for multi-slice pie/donut/bar charts, cycling with modulo if series > 10.",
      "Use status_colors for any status/severity badge or table status cell, keyed by the status string (case-insensitive).",
      "Use semantic_tokens.error_main for negative trend indicators (isPositive:false) and semantic_tokens.success_main for positive ones.",
      "Use accent_primary as the single-series fill for area/bar charts that are not comparative (e.g. one KPI trend line).",
      "Never emit a raw hex not present in this file for chart series color — pick from chart_palettes."
    ]
  }
}
