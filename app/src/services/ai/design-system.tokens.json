  "status_colors": {
    "note": "Consistent status vocabulary for badges/pills/table status cells (settingsSeverityStyles + DashboardTableRow.status).",
    "approved":  { "text": "#30a46c", "bg_light": "#e6f6eb", "bg_dark": "#132d21" },
    "completed": { "text": "#30a46c", "bg_light": "#e6f6eb", "bg_dark": "#132d21" },
    "pending":   { "text": "#f76b15", "bg_light": "#ffefd6", "bg_dark": "#331e0b" },
    "review":    { "text": "#0090ff", "bg_light": "#e6f4fe", "bg_dark": "#0d2847" },
    "critical":  { "text": "#ce2c31", "bg_light": "#feebec", "bg_dark": "#3b1219" },
    "rejected":  { "text": "#e5484d", "bg_light": "#feebec", "bg_dark": "#3b1219" }
  },

