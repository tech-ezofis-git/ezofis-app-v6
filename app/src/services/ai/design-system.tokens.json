      "body": "14px / weight 450",
      "caption_label": "11-12px / uppercase / letter-spacing / gray-11"
    }
  },

  "layout_tokens": {
    "radius_base": "5px",
    "card_radius": "12px",
    "button_radius": "6-8px",
    "pill_radius": "9999px (badges)",
    "shadow_sm": "0 1px 2px rgba(15,23,42,.05)",
    "shadow_md": "0 4px 12px -2px rgba(15,23,42,.08)",
    "shadow_lg": "0 12px 32px -8px rgba(15,23,42,.12)"
