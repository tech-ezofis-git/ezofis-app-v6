+    const32 = lambda a, lit: [(a << 8) | 0x14, lit & 0xFFFF, (lit >> 16) & 0xFFFF]
+    iget_obj = lambda a, b, ref: [(b << 12) | (a << 8) | 0x54, I(ref)]
