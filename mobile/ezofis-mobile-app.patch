+.qa-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
+.qa { border: 0; background: transparent; display: flex; flex-direction: column; align-items: center; gap: 8px; font-size: 12px; font-weight: 500; color: var(--ink); text-align: center; }
+.qa span.c { width: 58px; height: 58px; border-radius: 999px; border: 1px solid #E2D2FA; background: #fff; box-shadow: 0 6px 16px rgba(131,0,230,.12); display: flex; align-items: center; justify-content: center; color: var(--purple); }
+.qa span.c.t { border-color: #C7EDF1; color: var(--teal-text); box-shadow: 0 6px 16px rgba(10,124,137,.14); }
+.qa span.c.solid { background: var(--grad-cta); border: 0; color: #fff; }
+.kpi { border-radius: 18px; padding: 12px 14px; }
