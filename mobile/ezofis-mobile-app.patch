+.askai-input { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 10px; height: 48px; padding: 0 6px 0 16px; border-radius: 999px; border: 1.5px solid rgba(255, 255, 255, .35); background: rgba(255, 255, 255, .12); color: rgba(255, 255, 255, .9); font: inherit; font-size: 14px; text-align: left; cursor: pointer; }
+.askai-go { width: 36px; height: 36px; border-radius: 999px; background: #5CE1E6; color: #14101F; display: flex; align-items: center; justify-content: center; }
