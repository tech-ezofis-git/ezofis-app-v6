+  .utabs.live button.on { flex: 1 1 auto; }
+  .utabs.live button:not(.on) .lbl { display: none; }
+  .utabs.live { justify-content: space-between; }
+}
+.seg.mini { align-self: flex-start; padding: 3px; }
+.seg.mini { display: inline-grid; grid-template-columns: auto auto; }
+.seg.mini button { height: 34px; font-size: 13px; padding: 0 14px; }
+
+/* ---- form ---- */
+.form-h { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 40px; }
+.form-t { font-size: 16px; font-weight: 600; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.field-card.unfilled { background: #fff; border: 1.5px dashed #E2D8F0; }
+.field-card.unfilled .l { color: var(--muted); }
+.field-card.unfilled .v { color: #9C96AB; font-style: italic; font-size: 14px; }
+.open-chip { flex: none; display: inline-flex; align-items: center; gap: 4px; height: 30px; padding: 0 10px; border-radius: 999px; background: #fff; color: var(--teal-dark); font-size: 12px; font-weight: 600; }
+
+/* ---- line items ---- */
+.lines { display: flex; flex-direction: column; gap: 8px; }
+.lines-h { display: flex; justify-content: space-between; align-items: center; gap: 10px; border: 0; background: none; padding: 4px 0; font: inherit; color: var(--ink); cursor: pointer; text-align: left; }
+.lines-h > span:first-child { display: inline-flex; align-items: center; gap: 8px; font-size: 16px; }
+.line { border-radius: 14px; background: #fff; border: 1px solid var(--line); padding: 10px 12px; display: flex; flex-direction: column; gap: 8px; }
+.line.bad { border-color: #F3C2CE; background: #FFFBFC; }
+.line-top { display: flex; align-items: flex-start; gap: 10px; }
+.line-n { flex: none; width: 24px; height: 24px; border-radius: 8px; background: var(--tint-p); color: var(--deep); font-size: 12px; font-weight: 700; display: flex; align-items: center; justify-content: center; }
+.line-d { flex: 1; min-width: 0; font-size: 14px; font-weight: 600; line-height: 1.35; word-break: break-word; }
+.line-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; font-size: 14px; }
+.line-grid small { display: block; font-size: 11px; color: var(--muted); font-weight: 600; text-transform: uppercase; letter-spacing: .5px; }
+.line-grid em { display: block; font-style: normal; font-size: 11px; color: var(--bad-t); }
+.line-warn { font-size: 12px; color: var(--bad-t); }
+
+/* ---- file viewer ---- */
+.viewer { position: fixed; inset: 0; z-index: 80; background: #F4F1F8; display: flex; flex-direction: column; }
+.viewer-bar { display: flex; align-items: center; gap: 10px; padding: calc(var(--sat) + 8px) var(--gutter) 10px; background: #fff; border-bottom: 1px solid var(--line); }
+.viewer-t { font-size: 15px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+.viewer-s { font-size: 12px; color: var(--muted); }
+.viewer-body { flex: 1; overflow: auto; padding: 12px; display: flex; flex-direction: column; gap: 12px; -webkit-overflow-scrolling: touch; }
+.pdf-pages { display: flex; flex-direction: column; gap: 12px; align-items: center; }
+.pdf-page { max-width: 900px; background: #fff; box-shadow: 0 2px 10px rgba(46, 23, 71, .12); border-radius: 4px; }
+.viewer-img { max-width: 100%; height: auto; align-self: center; border-radius: 8px; background: #fff; }
+.viewer-text { margin: 0; white-space: pre-wrap; word-break: break-word; font-size: 13px; background: #fff; padding: 14px; border-radius: 12px; }
+
+/* ---- new request ---- */
+.choice-row { display: flex; flex-wrap: wrap; gap: 8px; }
+.wf-pick { display: flex; align-items: center; gap: 12px; text-align: left; }
+.wf-pick .ic { flex: none; width: 42px; height: 42px; border-radius: 12px; background: var(--tint-p); color: var(--purple); display: flex; align-items: center; justify-content: center; }
+
+/* ---- Home: updates on the hero, divider, Ask AI spotlight ---- */
+.sec-title.on-hero { color: #fff; margin-top: -88px; position: relative; z-index: 1; }
+.home-div { height: 1px; background: linear-gradient(90deg, transparent, #E2D8F0 12%, #E2D8F0 88%, transparent); margin: 14px 0 6px; }
+@media (min-width: 768px) { .home-div { display: none; } }
+
+.askai { position: relative; overflow: hidden; border-radius: 22px; padding: 16px; color: #fff; background: linear-gradient(135deg, #2E1747 0%, #643094 55%, #8300E6 100%); box-shadow: 0 14px 30px rgba(46, 23, 71, .28); display: flex; flex-direction: column; gap: 12px; margin-top: 6px; }
