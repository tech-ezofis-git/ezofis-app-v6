+}
+
+const LINES = [
+  ['Idea. Innovate.\nImplement.', 'Starting EZOFIS…'],
+  ['Say goodbye to\ntedious workflows.', 'Securing your session…'],
+  ['Your gateway to\nsmarter workflows.', 'Loading your workspace…'],
