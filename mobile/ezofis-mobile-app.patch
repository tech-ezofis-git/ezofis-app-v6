+    act_setcv = A.m(ACTV, 'setContentView', 'V', ['Landroid/view/View;']); act_win = A.m(ACTV, 'getWindow', WIN)
+    act_sfr = A.m(ACTV, 'startActivityForResult', 'V', [INTENT, 'I'])
+    win_sbc = A.m(WIN, 'setStatusBarColor', 'V', ['I'])
