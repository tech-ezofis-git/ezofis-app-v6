+    addNotif({ type: 'wf', title: `You ${past} ${id}`, body: `${req.workflow} · ${kind === 'danger' ? 'request closed' : 'moved to ' + nextStage}`, tone: kind === 'danger' ? 'r' : 'p', to: '/app/inbox?tab=actioned' });
