+.kpi .v { font-family: var(--head); font-weight: 700; font-size: 22px; margin-top: 2px; }
+.kpi .n { font-size: 12px; margin-top: 2px; color: var(--muted); }
+.kpi.p { background: var(--tint-p); border: 1px solid #EADDFB; } .kpi.p .k { color: var(--deep); }
+.kpi.t { background: var(--tint-t); border: 1px solid #C7EDF1; } .kpi.t .k { color: var(--teal-dark); }
+.kpi.solid { background: var(--grad-cta); color: #fff; } .kpi.solid .k, .kpi.solid .n { color: rgba(255,255,255,.85); }
+.kpis { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
+.bars { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; align-items: end; height: 92px; }
+.bars div { display: flex; flex-direction: column; align-items: center; gap: 6px; justify-content: flex-end; height: 100%; }
+.bars i { width: 100%; border-radius: 8px; background: var(--purple); display: block; }
+.bars i.e0 { background: var(--line2); }
+.bars span { font-size: 11px; color: var(--muted); }
+.pin-row { display: flex; justify-content: center; gap: 14px; }
+.pin { width: 60px; height: 70px; border: 1.5px solid #DCD6E6; border-radius: 18px; display: flex; align-items: center; justify-content: center; }
+.pin.on { border: 2px solid var(--purple); }
+.pin i { width: 14px; height: 14px; border-radius: 999px; background: var(--ink); }
+.pin-row.shake { animation: shake .4s; }
+@keyframes shake { 20%, 60% { transform: translateX(-8px); } 40%, 80% { transform: translateX(8px); } }
+.keypad { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; max-width: 320px; margin: 0 auto; width: 100%; }
+.keypad button { height: 58px; border: 0; border-radius: 16px; background: var(--surface); font-size: 22px; font-weight: 500; }
+.keypad button:active { background: var(--chip); }
+.id-card { border-radius: 18px; background: var(--tint-p); border: 1px solid #EADDFB; padding: 16px 18px; display: flex; flex-direction: column; gap: 10px; }
+.id-card span { display: flex; align-items: center; gap: 12px; font-size: 14px; }
+.sso { height: 50px; border-radius: 999px; border: 1px solid #747775; background: #fff; color: #1F1F1F; font-family: Roboto, Arial, sans-serif; font-weight: 500; font-size: 15px; position: relative; display: flex; align-items: center; justify-content: center; }
+.sso.ms { border-radius: 4px; border-color: #8C8C8C; color: #5E5E5E; font-family: 'Segoe UI', Roboto, Arial, sans-serif; font-weight: 600; }
+.sso .slot { position: absolute; left: 14px; width: 20px; height: 20px; border: 1.5px dashed #9C96AB; border-radius: 4px; }
+.or { display: flex; align-items: center; gap: 12px; color: var(--muted); font-size: 13px; }
+.or::before, .or::after { content: ''; flex: 1; height: 1px; background: var(--line); }
+
+/* ---------- split views (tablets) ---------- */
+.split { display: grid; grid-template-columns: minmax(320px, 400px) 1fr; flex: 1; min-height: 0; height: 100%; }
+.split > .pane-list { border-right: 1px solid var(--line); overflow-y: auto; min-height: 0; }
+.split > .pane-detail { overflow-y: auto; min-height: 0; display: flex; flex-direction: column; background: #fff; }
+.pane-empty { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; color: var(--muted); }
+@media (min-width: 768px) {
+  .kpis.four { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+  .home-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 20px; align-items: start; }
+  .files-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
+  .grid2.wide4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
+}
+@media (min-width: 1200px) { .files-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
+
+/* ---------- document preview ---------- */
+.docprev { border-radius: 16px; background: #FAFAFC; border: 1px solid var(--line); padding: 18px; display: flex; flex-direction: column; gap: 9px; min-height: 220px; }
+.docprev span { display: block; height: 8px; border-radius: 4px; background: #E2DCEC; }
+.docprev .hl { height: 14px; background: rgba(25,193,212,.3); border: 1px solid var(--teal); }
+.docprev .hp { height: 14px; background: rgba(131,0,230,.15); border: 1px solid var(--purple); }
+.success-ring { width: 96px; height: 96px; border-radius: 999px; display: flex; align-items: center; justify-content: center; }
+.success-ring > span { width: 68px; height: 68px; border-radius: 999px; display: flex; align-items: center; justify-content: center; animation: pop .5s; }
+.spinner { width: 18px; height: 18px; border-radius: 999px; border: 2.5px solid #E2D2FA; border-top-color: var(--purple); animation: spin .8s linear infinite; }
+.bubble { border-radius: 4px 16px 16px 16px; background: #F6F3FB; padding: 10px 12px; font-size: 14px; line-height: 1.45; }
+.avatar { flex: none; width: 34px; height: 34px; border-radius: 999px; background: #DDF6F9; color: var(--teal-dark); font-size: 12px; font-weight: 600; display: flex; align-items: center; justify-content: center; }
+.timeline { display: flex; gap: 12px; }
+.timeline .rail-l2 { flex: none; display: flex; flex-direction: column; align-items: center; }
+.timeline .rail-l2 i { width: 12px; height: 12px; border-radius: 999px; margin-top: 4px; }
+.timeline .rail-l2 b { width: 2px; flex: 1; background: var(--line); margin-top: 4px; }
+.progress { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 4px; }
+.progress span { height: 4px; border-radius: 999px; background: var(--line2); }
+.progress span.done { background: var(--ok); }
+.progress span.now { background: var(--purple); }
+.setting-row { min-height: 60px; display: flex; align-items: center; gap: 14px; padding: 0 4px; border-bottom: 1px solid var(--line); background: transparent; border-left: 0; border-right: 0; border-top: 0; width: 100%; text-align: left; font-size: 15px; color: var(--ink); }
+.setting-row .ic { width: 40px; height: 40px; border-radius: 12px; background: var(--tint-p); color: var(--purple); display: flex; align-items: center; justify-content: center; flex: none; }
+.setting-row .tx { flex: 1; }
+.setting-row .tx small { display: block; color: var(--muted); font-size: 12px; }
+
+/* ---------- folder selector ---------- */
+.folder-strip { display: flex; gap: 10px; overflow-x: auto; scrollbar-width: none; padding: 2px var(--gutter) 4px; scroll-snap-type: x proximity; }
+.folder-strip::-webkit-scrollbar { display: none; }
+.folder-card { flex: none; width: 168px; min-height: 104px; border-radius: 18px; border: 1.5px solid transparent; display: flex; flex-direction: column; align-items: flex-start; gap: 6px; padding: 12px 14px; text-align: left; scroll-snap-align: start; transition: box-shadow .15s, border-color .15s; }
