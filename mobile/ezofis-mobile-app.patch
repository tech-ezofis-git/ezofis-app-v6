+.folder-card .fc-name { font-size: 14px; font-weight: 600; line-height: 1.25; }
+.folder-card .fc-meta { font-size: 12px; color: var(--body); }
+.folder-card.on { border-color: var(--purple); box-shadow: 0 6px 16px rgba(131,0,230,.18); background: #fff; color: var(--purple); }
+.folder-card.on .fc-ic { background: var(--purple); color: #fff; }
+@media (min-width: 1200px) { .folder-strip { flex-wrap: wrap; overflow: visible; } }
+
+/* ---- live data (Workflow API) ---- */
+.skel { border-radius: 16px; background: linear-gradient(90deg, #F1ECF8 25%, #F8F5FC 50%, #F1ECF8 75%); background-size: 200% 100%; animation: skel 1.2s linear infinite; }
+@keyframes skel { from { background-position: 200% 0; } to { background-position: -200% 0; } }
+.notice { border-radius: 14px; padding: 12px 14px; font-size: 13px; line-height: 1.45; display: flex; gap: 10px; align-items: flex-start; }
+.notice.bad { background: var(--tint-r); color: var(--bad-t); } .notice.warn { background: var(--tint-a); color: var(--warn-t); } .notice.info { background: var(--tint-t); color: var(--teal-dark); }
+.notice .grow { flex: 1; min-width: 0; }
+.notice button { border: 0; background: none; font: inherit; font-weight: 600; color: inherit; text-decoration: underline; padding: 0; cursor: pointer; }
+.grp-h { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin-top: 8px; }
+.grp-h b { font-size: 15px; color: var(--ink); } .grp-h span { font-size: 12px; color: var(--muted); }
+.card .meta-line { display: flex; gap: 10px; flex-wrap: wrap; font-size: 12px; color: var(--muted); margin-top: 6px; }
+.card .meta-line i { font-style: normal; display: inline-flex; gap: 4px; align-items: center; }
+.tbl-row { border-radius: 14px; background: var(--tint-p); padding: 10px 14px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 4px 12px; font-size: 13px; }
+.tbl-row .l { color: var(--deep); font-weight: 600; } .tbl-row .v { word-break: break-word; }
+.ai-card { border-radius: 16px; padding: 12px 14px; background: var(--tint-t); display: flex; flex-direction: column; gap: 6px; }
+.ai-card .r { font-size: 13px; line-height: 1.45; color: var(--body); }
+.load-more { align-self: center; }
+
+/* ---- tabs: label + count badge always on one line ---- */
+.seg button { display: flex; align-items: center; justify-content: center; gap: 6px; white-space: nowrap; min-width: 0; padding: 0 6px; overflow: hidden; }
+.cnt { display: inline-flex; align-items: center; justify-content: center; flex: none; min-width: 20px; height: 20px; padding: 0 6px; border-radius: 999px; background: rgba(131, 0, 230, .12); color: var(--deep); font-size: 11px; font-weight: 700; line-height: 1; }
+.seg button.on .cnt { background: rgba(255, 255, 255, .26); color: #fff; }
+.seg .lbl-s { display: none; }
+.utabs button { white-space: nowrap; min-width: 0; padding: 0 4px; }
+.utabs button.on .cnt { background: var(--purple); color: #fff; }
+.utabs.live { display: flex; }
+.utabs.live button { flex: 1 1 0; }
+@media (max-width: 400px) {
+  .seg button { font-size: 13px; gap: 4px; padding: 0 4px; }
+  .utabs button { font-size: 12px; gap: 4px; }
+}
+@media (max-width: 374px) {
+  .seg .lbl-l { display: none; } .seg .lbl-s { display: inline; }
+  /* ticket tabs: the active tab keeps its label, the others show icon + count */
