+.askai-chips.light .askai-chip { background: var(--tint-t); border-color: #C7EDF1; color: var(--teal-dark); }
+
+.qa span.c.ai { position: relative; border: 0; background: linear-gradient(135deg, #8300E6, #19C1D4); color: #fff; box-shadow: 0 8px 20px rgba(131, 0, 230, .3); }
