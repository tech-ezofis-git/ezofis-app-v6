+    S_NOTIFY, S_PERM, S_PN, S_ASK, S_DEN, S_GR, S_NS, S_CH, S_CHN, S_OK = (A.s(x) for x in ('ezofis:notify', 'ezofis:perm', 'android.permission.POST_NOTIFICATIONS',
