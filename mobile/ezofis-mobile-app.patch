+.qa.ai { color: var(--deep); font-weight: 700; }
+.qa-new { position: absolute; top: -6px; right: -10px; height: 18px; padding: 0 6px; font-size: 10px; box-shadow: 0 2px 6px rgba(0, 0, 0, .15); }
+
+.ai-thread { display: flex; flex-direction: column; gap: 10px; max-height: 42vh; overflow-y: auto; }
+.ai-me { align-self: flex-end; max-width: 85%; background: var(--grad-cta); color: #fff; padding: 9px 13px; border-radius: 16px 16px 4px 16px; font-size: 14px; }
