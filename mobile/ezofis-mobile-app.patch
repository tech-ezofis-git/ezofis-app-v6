+
+// ---------- caches (per session) ----------
+const metaCache = new Map();
+const formCache = new Map();
+let listCache = null;
+// Every uploaded file (attachments, new-request files, form file fields) is limited to 20 MB.
+export const MAX_FILE_MB = 20;
