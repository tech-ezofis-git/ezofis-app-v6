# Local settings for `npm run dev` (scripts/dev-start.ps1 -Only mobile).
# Copy this file to .env.development.local (git-ignored, never committed) and keep it pointing at your LOCAL API.
# Vite reads .env.development.local only for the dev server, so release builds and test APKs are not affected.
# dev-start.ps1 refuses to start while either value points at production (cloud.ezofis.com).

# The app calls /api on its own origin...
VITE_API_BASE=/api
# ...and the dev server forwards it to the local API started by dev-start.ps1 (dotnet watch run).
VITE_API_PROXY_TARGET=http://localhost:5000
